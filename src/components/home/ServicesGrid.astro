---
import { services } from '../../data/services';

const iconMap: Record<string, string> = {
  home: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  building: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  store: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
  wrench: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
};
---

<section class="py-20 bg-white" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-forteza-gold text-sm font-semibold uppercase tracking-widest">Lo que hacemos</span>
      <h2 id="services-heading" class="font-display text-3xl sm:text-4xl font-bold text-forteza-green mt-2">
        Nuestros servicios
      </h2>
      <p class="mt-4 text-gray-500 max-w-2xl mx-auto">
        Cubrimos todas las etapas de la construcción y remodelación. Cada proyecto se maneja con supervisión técnica permanente y comunicación directa con el cliente.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
      {services.map((service) => (
        <li>
          <a
            href={`/servicios#${service.id}`}
            class="group flex flex-col h-full bg-white border border-gray-100 rounded-xl p-6 hover:border-forteza-green hover:shadow-md transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forteza-green"
            aria-label={`Ver servicio: ${service.title}`}
          >
            <div class="text-forteza-green mb-4" set:html={iconMap[service.icon]} />
            <h3 class="font-semibold text-forteza-green text-lg mb-2 group-hover:text-forteza-green-light transition-colors">
              {service.title}
            </h3>
            <p class="text-gray-500 text-sm leading-relaxed flex-1">{service.shortDescription}</p>
            <span class="mt-4 text-forteza-gold text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
              Ver más
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
