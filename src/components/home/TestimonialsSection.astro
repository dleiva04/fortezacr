---
const testimonials = [
  {
    name: 'Carlos Rodríguez',
    zone: 'Santa Ana, San José',
    text: 'Forteza CR construyó nuestra casa en 9 meses, exactamente como lo prometieron. La calidad de los acabados superó nuestras expectativas y el equipo siempre estuvo disponible para resolver dudas.',
    image: '/images/testimonial-1.jpg',
    rating: 5,
  },
  {
    name: 'María Fernández',
    zone: 'Escazú, San José',
    text: 'Remodelamos la cocina completa con Forteza y quedó increíble. Trabajo limpio, puntual y el resultado es exactamente lo que queríamos. Los recomiendo sin dudarlo.',
    image: '/images/testimonial-2.jpg',
    rating: 5,
  },
  {
    name: 'Roberto Solís',
    zone: 'Heredia Centro',
    text: 'Desarrollamos un condominio de 20 unidades con ellos. Gestión impecable, cumplimiento de plazos y excelente comunicación durante todo el proceso. Ya tenemos otro proyecto en mente.',
    image: '/images/testimonial-3.jpg',
    rating: 5,
  },
];
---

<section class="py-20 bg-white" aria-labelledby="testimonials-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-forteza-gold text-sm font-semibold uppercase tracking-widest">Lo que dicen</span>
      <h2 id="testimonials-heading" class="font-display text-3xl sm:text-4xl font-bold text-forteza-green mt-2">
        Clientes satisfechos
      </h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6" role="list">
      {testimonials.map((t) => (
        <li class="bg-forteza-light rounded-xl p-6 flex flex-col">
          <!-- Stars -->
          <div class="flex gap-1 mb-4" aria-label={`Calificación: ${t.rating} de 5 estrellas`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg class="w-5 h-5 text-forteza-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <blockquote class="text-gray-600 text-sm leading-relaxed flex-1 italic">
            "{t.text}"
          </blockquote>

          <div class="flex items-center gap-3 mt-6 pt-4 border-t border-gray-200">
            <img
              src={t.image}
              alt={`Foto de ${t.name}`}
              class="w-10 h-10 rounded-full object-cover"
              width="40"
              height="40"
              loading="lazy"
            />
            <div>
              <p class="font-semibold text-forteza-green text-sm">{t.name}</p>
              <p class="text-gray-400 text-xs">{t.zone}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
