---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

const iconMap: Record<string, string> = {
  home:     `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-forteza-gold" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  building: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-forteza-gold" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  store:    `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-forteza-gold" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
  wrench:   `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-forteza-gold" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
};
---

<BaseLayout
  title="Servicios de construcción"
  description="Forteza CR ofrece construcción de casas, edificios, proyectos comerciales y remodelaciones en Costa Rica. Conoce todos nuestros servicios y cómo podemos ayudarte."
>
  <section class="py-16 bg-white" aria-labelledby="services-page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Rutas de navegación" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href="/" class="hover:text-forteza-green transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-forteza-green font-medium" aria-current="page">Servicios</li>
        </ol>
      </nav>

      <div class="text-center mb-14">
        <span class="text-forteza-gold text-sm font-semibold uppercase tracking-widest">Lo que hacemos</span>
        <h1 id="services-page-heading" class="font-display text-3xl sm:text-4xl font-bold text-forteza-green mt-2">
          Nuestros servicios
        </h1>
        <p class="mt-4 text-gray-500 max-w-2xl mx-auto">
          Cubrimos todo el ciclo de la construcción: desde el primer boceto hasta la entrega de llaves.
          Cada servicio incluye supervisión técnica, materiales de calidad y comunicación directa.
        </p>
      </div>

      <div class="space-y-20">
        {services.map((service, i) => (
          <article
            id={service.id}
            class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center scroll-mt-20"
            aria-labelledby={`service-${service.id}-heading`}
          >
            <div class:list={['', i % 2 === 1 ? 'lg:order-2' : '']}>
              <img
                src={service.image}
                alt={`${service.title} — ejemplo de proyecto de Forteza CR`}
                class="w-full h-80 object-cover rounded-2xl shadow-md"
                width="800"
                height="500"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class:list={['', i % 2 === 1 ? 'lg:order-1' : '']}>
              <div class="mb-4" set:html={iconMap[service.icon]} />
              <h2 id={`service-${service.id}-heading`} class="font-display text-2xl sm:text-3xl font-bold text-forteza-green mb-4">
                {service.title}
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6">{service.longDescription}</p>
              <ul class="space-y-2 mb-8" role="list">
                {service.features.map((f) => (
                  <li class="flex items-center gap-2 text-sm text-gray-700">
                    <svg class="w-5 h-5 text-forteza-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <div class="flex gap-3">
                <a
                  href="/cotizar"
                  class="bg-forteza-green hover:bg-forteza-green-light text-white font-semibold px-5 py-2 rounded-lg text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forteza-green"
                >
                  Cotizar
                </a>
                <a
                  href="/proyectos"
                  class="border-2 border-forteza-green text-forteza-green hover:bg-green-50 font-semibold px-5 py-2 rounded-lg text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forteza-green"
                >
                  Ver proyectos
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
