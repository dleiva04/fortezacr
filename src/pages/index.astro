---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import BeforeAfterSection from '../components/home/BeforeAfterSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
---

<BaseLayout
  title="Constructora en Costa Rica"
  description="Forteza CR — Empresa constructora en Costa Rica. Casas, edificios, proyectos comerciales y remodelaciones con calidad y cumplimiento garantizados."
>
  <HeroSection />
  <ServicesGrid />
  <FeaturedProjects />
  <BeforeAfterSection />
  <TestimonialsSection />

  <!-- Final CTA -->
  <section class="py-20 bg-forteza-green" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h2 id="cta-heading" class="font-display text-3xl sm:text-4xl font-bold mb-4">
        ¿Listo para iniciar tu proyecto?
      </h2>
      <p class="text-green-200 text-lg mb-8 max-w-xl mx-auto">
        Usa nuestro cotizador guiado y obtén un estimado en menos de 2 minutos. Sin compromisos.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/cotizar"
          class="inline-flex items-center justify-center gap-2 bg-forteza-gold hover:bg-forteza-gold-light text-white font-semibold px-8 py-3 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forteza-gold focus-visible:ring-offset-2 focus-visible:ring-offset-forteza-green"
        >
          Cotizar mi proyecto
        </a>
        <a
          href="https://wa.me/50600000000?text=Hola%20Forteza%20CR%2C%20quisiera%20información%20sobre%20un%20proyecto."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-8 py-3 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label="Contactar por WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribirnos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
