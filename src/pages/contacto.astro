---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto"
  description="Contáctanos para iniciar tu proyecto de construcción o remodelación en Costa Rica. Estamos en San José y atendemos todo el país."
>
  <section class="py-16 bg-white" aria-labelledby="contact-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Rutas de navegación" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href="/" class="hover:text-forteza-green transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-forteza-green font-medium" aria-current="page">Contacto</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">
        <!-- Left: info -->
        <div>
          <span class="text-forteza-gold text-sm font-semibold uppercase tracking-widest">Hablemos</span>
          <h1 id="contact-heading" class="font-display text-3xl sm:text-4xl font-bold text-forteza-green mt-2 mb-6">
            Inicia tu proyecto hoy
          </h1>

          <p class="text-gray-600 leading-relaxed mb-8">
            Cuéntanos qué tienes en mente y un especialista de Forteza CR te responderá en menos de 24 horas. También puedes usar nuestro cotizador para tener un estimado inmediato.
          </p>

          <address class="not-italic space-y-5 text-sm">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-forteza-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-800">Teléfono</p>
                <a href="tel:+50600000000" class="text-gray-500 hover:text-forteza-green transition-colors">+506 0000-0000</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-forteza-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-800">Correo</p>
                <a href="mailto:info@fortezacr.com" class="text-gray-500 hover:text-forteza-green transition-colors">info@fortezacr.com</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-forteza-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <p class="font-medium text-gray-800">Ubicación</p>
                <p class="text-gray-500">San José, Costa Rica</p>
                <p class="text-gray-400 text-xs mt-0.5">Atendemos proyectos en todo el país</p>
              </div>
            </div>
          </address>

          <div class="mt-8">
            <a
              href="https://wa.me/50600000000?text=Hola%20Forteza%20CR%2C%20quisiera%20información%20sobre%20un%20proyecto."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold px-6 py-3 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Escribirnos por WhatsApp
            </a>
          </div>

          <!-- Map placeholder -->
          <div class="mt-8 rounded-xl overflow-hidden bg-gray-100 h-48 flex items-center justify-center border border-gray-200" aria-label="Mapa de ubicación (próximamente)">
            <p class="text-gray-400 text-sm">Mapa interactivo próximamente</p>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-forteza-light rounded-2xl p-8">
          <h2 class="font-semibold text-forteza-green text-xl mb-6">Envíanos un mensaje</h2>
          <form
            action="#"
            method="post"
            class="space-y-5"
            aria-label="Formulario de contacto"
            novalidate
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span aria-label="requerido" class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  autocomplete="given-name"
                  class="w-full border border-gray-200 bg-white rounded-lg px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-forteza-green transition-colors"
                  placeholder="Juan"
                />
              </div>
              <div>
                <label for="contact-lastname" class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
                <input
                  type="text"
                  id="contact-lastname"
                  name="lastname"
                  autocomplete="family-name"
                  class="w-full border border-gray-200 bg-white rounded-lg px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-forteza-green transition-colors"
                  placeholder="Rodríguez"
                />
              </div>
            </div>
            <div>
              <label for="contact-phone" class="block text-sm font-medium text-gray-700 mb-1">Teléfono / WhatsApp <span aria-label="requerido" class="text-red-500">*</span></label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                autocomplete="tel"
                class="w-full border border-gray-200 bg-white rounded-lg px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-forteza-green transition-colors"
                placeholder="+506 8888-8888"
              />
            </div>
            <div>
              <label for="contact-type" class="block text-sm font-medium text-gray-700 mb-1">Tipo de proyecto</label>
              <select
                id="contact-type"
                name="project_type"
                class="w-full border border-gray-200 bg-white rounded-lg px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-forteza-green transition-colors"
              >
                <option value="">Selecciona una opción</option>
                <option value="casa">Casa / Residencia</option>
                <option value="condominio">Edificio / Condominio</option>
                <option value="comercial">Proyecto Comercial</option>
                <option value="remodelacion">Remodelación / Ampliación</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-1">Descripción del proyecto <span aria-label="requerido" class="text-red-500">*</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class="w-full border border-gray-200 bg-white rounded-lg px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-forteza-green transition-colors resize-none"
                placeholder="Cuéntanos sobre tu proyecto: zona, tamaño aproximado, tiempo estimado de inicio…"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-forteza-green hover:bg-forteza-green-light text-white font-semibold py-3 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forteza-green"
            >
              Enviar mensaje
            </button>
            <p class="text-xs text-gray-400 text-center">
              Respondemos en menos de 24 horas hábiles.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
