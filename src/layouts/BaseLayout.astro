---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: object;
}

const {
  title,
  description = 'Forteza CR — Empresa constructora en Costa Rica especializada en casas, edificios, proyectos comerciales y remodelaciones.',
  ogImage = '/images/hero-bg.jpg',
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Forteza CR',
  description: 'Empresa constructora en Costa Rica especializada en casas, edificios, proyectos comerciales y remodelaciones.',
  url: 'https://fortezacr.com',
  telephone: '+506-0000-0000',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CR',
    addressLocality: 'San José',
    addressRegion: 'San José',
  },
  areaServed: ['Costa Rica'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+506-0000-0000',
    availableLanguage: 'Spanish',
  },
};

const finalSchema = schema ?? baseSchema;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <title>{title} | Forteza CR</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Forteza CR`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="Forteza CR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Forteza CR`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-gray-800 font-sans antialiased">
    <!-- Skip to main content (accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-forteza-green focus:text-white focus:rounded-md focus:text-sm focus:font-semibold"
    >
      Saltar al contenido principal
    </a>

    <Navbar />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
    <Analytics />
  </body>
</html>
